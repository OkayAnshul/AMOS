# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Get a key: https://aistudio.google.com/apikey
#
# Every setting below is real and read by something — a test enforces that
# (tests/unit/test_config.py::test_every_setting_is_read_by_something), because
# this file previously stopped at V0.3 while fourteen settings had arrived since,
# and one of those (AMOS_ASYNC_ENABLED) was read by nothing at all.
# Defaults shown are the code defaults; every line here is optional except the key.

# --- LLM provider (V0.1) ---
AMOS_GEMINI_API_KEY=your-key-here
# Quota binds in more than one shape: gemini-3.5-flash is 20/DAY, and the -lite
# default is 15/MINUTE. See docs/21-technology-baseline.md, which is canonical.
# Lite is the dev default; switch to gemini-3.5-flash for demo quality.
AMOS_LLM_MODEL=gemini-3.5-flash-lite
AMOS_LLM_TIMEOUT_SECONDS=30
AMOS_LLM_MAX_REPAIR_ATTEMPTS=2
AMOS_LLM_TEMPERATURE=0.2

# --- Agent loop (V0.2) ---
# The hard cap on tool-calling iterations. The cap is the termination proof.
AMOS_AGENT_MAX_ITERATIONS=5
# read_file may not resolve outside this directory, symlinks included.
AMOS_TOOL_SANDBOX_ROOT=.

# --- App ---
AMOS_ENV=development
AMOS_LOG_LEVEL=INFO

# --- Database (V0.3) ---
# Matches compose.yaml. Start it with `podman-compose up -d`.
AMOS_DATABASE_URL=postgresql+asyncpg://amos:amos@localhost:5432/amos
AMOS_DB_ECHO=false

# --- Orchestration (V0.4) ---
AMOS_PLANNING_ENABLED=true
AMOS_TASK_MAX_ATTEMPTS=3
# Wall time for one task attempt. Must stay above the per-call bounds beneath it
# and below AMOS_WORKER_VISIBILITY_TIMEOUT — see ADR-009 for why the ordering is
# the decision, not the number.
AMOS_TASK_TIMEOUT_SECONDS=300

# --- Retrieval (V0.5) ---
# 1536, not the model's 3072 default: pgvector's HNSW index tops out at 2000.
# Changing this means re-embedding the entire corpus. See ADR-008.
AMOS_EMBEDDING_MODEL=gemini-embedding-001
AMOS_EMBEDDING_DIMENSIONS=1536
# Below this cosine similarity a hit is noise and is dropped.
AMOS_RETRIEVAL_MIN_SCORE=0.30

# --- Memory (V0.6) ---
AMOS_MEMORY_ENABLED=true
AMOS_MEMORY_MIN_SCORE=0.30
# Guarantees the system never claims to have remembered something it did not
# store. Set false only to capture a baseline for `make memory-trials`.
AMOS_MEMORY_RECONCILE_ENABLED=true

# --- Multi-agent (V0.7) ---
# Each of these costs LLM calls. Disable them on a tight quota.
AMOS_MULTI_AGENT_ENABLED=true
AMOS_CRITIC_ENABLED=true
AMOS_MAX_REVISIONS=1

# --- Asynchronous execution (V0.8) ---
# Mounts POST /v1/goals/async. Off by default: queueing with no worker running
# leaves runs QUEUED forever, so this is a deployment decision. Start a worker
# with `make worker`.
AMOS_ASYNC_ENABLED=false
AMOS_WORKER_POLL_INTERVAL=2.0
AMOS_WORKER_MAX_ATTEMPTS=3
# When a RUNNING run is presumed abandoned and returned to the queue.
AMOS_WORKER_VISIBILITY_TIMEOUT=600

# --- Observability (V0.9) ---
# Empty disables tracing entirely; no collector is required to run AMOS.
AMOS_OTLP_ENDPOINT=
AMOS_OTEL_SERVICE_NAME=amos
# Goal text as a span attribute. Off by default — spans are shipped, stored and
# searchable, so the safe direction has to be the default.
AMOS_TRACE_CONTENT=false
