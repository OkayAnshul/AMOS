# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Get a key: https://aistudio.google.com/apikey

# --- LLM provider (V0.1) ---
AMOS_GEMINI_API_KEY=your-key-here
AMOS_LLM_MODEL=gemini-3.5-flash
AMOS_LLM_TIMEOUT_SECONDS=30
AMOS_LLM_MAX_REPAIR_ATTEMPTS=2

# --- App ---
AMOS_ENV=development
AMOS_LOG_LEVEL=INFO

# --- Database (arrives V0.3, unused before then) ---
# AMOS_DATABASE_URL=postgresql+asyncpg://amos:amos@localhost:5432/amos
