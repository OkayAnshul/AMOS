/.bash_profile
/.bashrc
/.gitconfig
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.idea
/.vscode

# Database dumps (make backup). Local only: they hold API key hashes and memories.
backups/
